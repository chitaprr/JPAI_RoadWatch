# Skopiuj ten plik jako `.env` (tylko do developmentu).

PORT=8000
LOG_LEVEL="debug"
ALLOWED_ORIGINS="http://localhost:3000"

DATABASE_URL="postgresql://roadwatch:roadwatch@localhost:5432/roadwatch?schema=public"
JWT_SECRET="secret"
PRODUCTION="false"

# Katalog na przesłane pliki (w produkcji volume Dockera).
UPLOAD_DIR="./upload"

# Web Push (opcjonalny). Bez tych zmiennych powiadomienia push są wyłączone,
# a reszta aplikacji działa normalnie. Wygeneruj klucze VAPID:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@roadwatch.local"
