# Production environment for docker-compose.prod.yml
# Copy to .env on the VM and fill in real values.

# --- Postgres ---
POSTGRES_DB=roadwatch
POSTGRES_USER=roadwatch
POSTGRES_PASSWORD=roadwatch

# --- Backend ---
UPLOAD_DIR=/app/upload
DATABASE_URL=postgresql://roadwatch:roadwatch@postgres:5432/roadwatch?schema=public
PORT=8000
LOG_LEVEL=debug
ALLOWED_ORIGINS=http://149.156.194.192:8102
JWT_SECRET=CHANGE
PRODUCTION=true

# --- Port mappings ---
POSTGRES_PORT=5432
BACKEND_PORT=8103
FRONTEND_PORT=8102
